# Copy to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=production

# MongoDB connection string (server-side only, never in the frontend)
MONGO_URI=your_mongodb_uri

# At least 32 random characters, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1d

# Allowed browser origin(s) for CORS, comma-separated
CLIENT_URL=https://yourfrontend.com

# Number of reverse-proxy hops in front of the API (Render = 1)
TRUST_PROXY=1

# Oldest allowed transaction time for offline sales synced later (days)
OFFLINE_SALE_MAX_AGE_DAYS=30

# Optional e-mail notifications for expenses
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@example.com
ADMIN_EMAILS=admin@example.com
APP_URL=https://yourfrontend.com
